# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://prreview:prreview@db:5432/prreview

# LLM (fill in whichever provider you choose in Phase 2)
LLM_PROVIDER=anthropic          # anthropic | openai | gemini | ollama
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Embeddings: 384 dims matches sentence-transformers BAAI/bge-small-en-v1.5.
# If you change the model, change this AND vector(384) in db/init.sql, then recreate the DB volume.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# GitHub (used from Phase 1)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
